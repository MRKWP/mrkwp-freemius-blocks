{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 3,
	"name": "mrkwp/freemius-pricing-plan-header",
	"version": "1.0.0",
	"title": "Plan Header",
	"category": "widgets",
	"parent": [ "mrkwp/freemius-pricing-plan" ],
	"icon": "heading",
	"description": "Plan title and subtitle.",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Professional"
		},
		"subtitle": {
			"type": "string",
			"default": "For freelancers and startups"
		},
		"textAlign": {
			"type": "string"
		},
		"titleTag": {
			"type": "string",
			"default": "h3"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"heading": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"textTransform": true,
			"textDecoration": true,
			"letterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "mrkwp-freemius",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
